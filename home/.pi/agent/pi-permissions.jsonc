{
    "defaultPolicy": {
        "tools": "ask",
        "bash": "ask",
        "mcp": "ask",
        "skills": "ask",
        "special": "ask",
    },
    "tools": {
        "read": "allow",
        "edit": "allow",
        "write": "allow",
        "find": "allow",
        "grep": "allow",
        "ls": "allow",
        "codemode": "allow",

        // Web
        "web_search": "allow",
        "fetch_content": "allow",
        "get_search_content": "allow",

        // Pi docs
        "read:/opt/pi": "allow",
        "read:/opt/pi/*": "allow",
        "grep:/opt/pi": "allow",
        "grep:/opt/pi/*": "allow",
        "ls:/opt/pi": "allow",
        "ls:/opt/pi/*": "allow",
        "find:/opt/pi": "allow",
        "find:/opt/pi/*": "allow",
        "edit:/opt/pi": "deny",
        "edit:/opt/pi/*": "deny",
        "write:/opt/pi": "deny",
        "write:/opt/pi/*": "deny",

        // Pi user settings (home)
        "read:/home/tetafro/.pi": "allow",
        "read:/home/tetafro/.pi/*": "allow",
        "grep:/home/tetafro/.pi": "allow",
        "grep:/home/tetafro/.pi/*": "allow",
        "ls:/home/tetafro/.pi": "allow",
        "ls:/home/tetafro/.pi/*": "allow",
        "find:/home/tetafro/.pi": "allow",
        "find:/home/tetafro/.pi/*": "allow",
        "edit:/home/tetafro/.pi": "deny",
        "edit:/home/tetafro/.pi/*": "deny",
        "write:/home/tetafro/.pi": "deny",
        "write:/home/tetafro/.pi/*": "deny",

        // Pi user settings (work)
        "read:/home/dkrivak/.pi": "allow",
        "read:/home/dkrivak/.pi/*": "allow",
        "grep:/home/dkrivak/.pi": "allow",
        "grep:/home/dkrivak/.pi/*": "allow",
        "ls:/home/dkrivak/.pi": "allow",
        "ls:/home/dkrivak/.pi/*": "allow",
        "find:/home/dkrivak/.pi": "allow",
        "find:/home/dkrivak/.pi/*": "allow",
        "edit:/home/dkrivak/.pi": "deny",
        "edit:/home/dkrivak/.pi/*": "deny",
        "write:/home/dkrivak/.pi": "deny",
        "write:/home/dkrivak/.pi/*": "deny",
    },
    "bash": {
        // Basic tools
        "ls *": "allow",
        "wc *": "allow",
        "file *": "allow",
        "sed *": "allow",
        "sed *e *": "ask",
        "awk *": "allow",
        "awk *system(*": "ask",
        "cat *": "allow",
        "nl *": "allow",
        "echo *": "allow",
        "diff *": "allow",
        "grep *": "allow",
        "find *": "allow",
        "find *-exec*": "ask",
        "find *-delete*": "ask",
        "xargs *": "allow",
        "true *": "allow",
        "false *": "allow",
        "head *": "allow",
        "tail *": "allow",
        "man *": "allow",
        "col *": "allow",
        "uname *": "allow",
        "sha256sum *": "allow",
        "command -v *": "allow",
        "test -x *": "allow",
        "mkdir *": "allow",
        "sleep *": "allow",
        "mkdir *": "allow",
        "date *": "allow",
        "readlink *": "allow",

        // Extended tools
        "rg *": "allow",
        "jq *": "allow",
        "yq *": "allow",
        "gofmt *": "allow",

        // Git
        "git diff *": "allow",
        "git log *": "allow",
        "git rev-parse *": "allow",
        "git show *": "allow",
        "git status *": "allow",
        "git ls-remote *": "allow",

        // Code validations
        "make lint": "allow",
        "make test": "allow",
        "ansible-lint *": "allow",
        "yamllint *": "allow",

        // Syntax checks
        "bash -n *": "allow",
        "python -m py_compile *": "allow",
        "python3 -m py_compile *": "allow",
        "python -m compileall *": "allow",
        "python3 -m compileall *": "allow",

        // Build tools
        "docker version *": "allow",
        "docker images *": "allow",
        "docker ps *": "allow",
        "docker build *": "allow",
    },
    "special": {
        "external_directory": "ask",
        "external_directory:/opt/pi": "allow",
        "external_directory:/opt/pi/*": "allow",
        "external_directory:/tmp": "allow",
        "external_directory:/tmp/*": "allow",
        "external_directory:/home/tetafro/.pi": "allow",
        "external_directory:/home/tetafro/.pi/*": "allow",
        "external_directory:/home/dkrivak/.pi": "allow",
        "external_directory:/home/dkrivak/.pi/*": "allow",
    }
}
