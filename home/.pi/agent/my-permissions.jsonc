{
    "directories": {
        "/opt/pi": "read",
        "/tmp": "write",

        // Home
        "/home/tetafro/.go": "read",
        "/home/tetafro/.pi": "read",
        "/home/tetafro/dev/pet": "read",
        "/home/tetafro/dev/pet/go-template": "read",
        "/home/tetafro/notes/": "read",

        // Work
        "/home/dkrivak/.go": "read",
        "/home/dkrivak/.pi": "read",
        "/home/dkrivak/dev/pet": "read",
        "/home/dkrivak/dev/pet/go-template": "read",
        "/home/dkrivak/notes/": "read",
    },
    "tools": {
        "read": "allow",
        "edit": "allow",
        "write": "allow",
        "find": "allow",
        "grep": "allow",
        "ls": "allow",
        "codemode": "allow",
        "web_enable": "allow",
        "web_search": "allow",
        "fetch_content": "allow",
        "get_search_content": "allow",
        "mcp__grafana__*": "allow",
        "mcp__torrents__*": "allow"
    },
    "bash": {
        // Basic tools
        "awk *": "allow",
        "awk *system(*": "ask",
        "cat *": "allow",
        "col *": "allow",
        "command -v *": "allow",
        "date *": "allow",
        "df *": "allow",
        "diff *": "allow",
        "du *": "allow",
        "echo *": "allow",
        "false *": "allow",
        "file *": "allow",
        "find *": "allow",
        "find *-delete*": "ask",
        "find *-exec*": "ask",
        "free *": "allow",
        "getent *": "allow",
        "grep *": "allow",
        "head *": "allow",
        "ls *": "allow",
        "man *": "allow",
        "mkdir *": "allow",
        "nl *": "allow",
        "nproc *": "allow",
        "readlink *": "allow",
        "sed *": "allow",
        "sed *e *": "ask",
        "sha256sum *": "allow",
        "sleep *": "allow",
        "stat *": "allow",
        "tail *": "allow",
        "test *": "allow",
        "true *": "allow",
        "uname *": "allow",
        "wc *": "allow",
        "xargs *": "allow",

        // Extended tools
        "pi --version": "allow",
        "pi --help": "allow",
        "pi list": "allow",
        "pi mcp list *": "allow",
        "rg *": "allow",
        "jq *": "allow",
        "yq *": "allow",

        // Git
        "git diff *": "allow",
        "git log *": "allow",
        "git rev-parse *": "allow",
        "git show *": "allow",
        "git status *": "allow",
        "git ls-remote *": "allow",
        "git ls-files *": "allow",

        // Make
        "make lint": "allow",
        "make test": "allow",

        // Deploy
        "ansible-lint *": "allow",
        "yamllint *": "allow",

        // Languages
        "golangci-lint run *": "allow",
        "bash -n *": "allow",
        "python -m py_compile *": "allow",
        "python3 -m py_compile *": "allow",
        "python -m compileall *": "allow",
        "python3 -m compileall *": "allow",
        "go version *": "allow",
        "go vet *": "allow",
        "go env *": "allow",
        "go mod tidy": "allow",
        "go test *": "allow",
        "go build *": "allow",
        "gofmt *": "allow",

        // Docker
        "docker version *": "allow",
        "docker images *": "allow",
        "docker ps *": "allow",
        "docker build *": "allow",
        "docker stats *": "allow",
        "docker inspect *": "allow"
    }
}
