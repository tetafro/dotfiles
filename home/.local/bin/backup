#!/bin/bash
# Backup files from local computer to network storage.
set -euo pipefail

# Magic variable for duration
SECONDS=0

nfs=$HOME/mnt/denis
dst=$nfs/backup/laptop/$(date +%Y%m%d)

function backup_dir {
    path=$1
    dir=$(basename "$path")
    parent=$(dirname "$path")
    backup="$dst/${dir#.}.tar.gz.enc"

    echo "Backup '$path' to '$backup'"
    echo "Ensure permissions $path"
    sudo chown -R $USER:$USER $path
    echo "Archive $path"
    tar -cz -C "$parent" "$path" | \
        openssl aes-256-cbc \
            -md sha512 -iter 1000 -pbkdf2 -salt \
            -k "$password" \
            -out "$backup"
}

read -s -p "Set password: " password

echo "Starting..."

echo "Mount remote storage"
mount $nfs

echo "Create destination directory"
mkdir -p $dst

backup_dir ~/dev
backup_dir ~/notes
backup_dir ~/.config/openvpn
backup_dir ~/.ssh

duration=$SECONDS
echo "Finished in $(($duration / 60))m $(($duration % 60))s"
